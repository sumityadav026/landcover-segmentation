{
  "project": {
    "name": "urban_land_cover_segmentation",
    "title": "Urban Land Cover Mapping via Deep Semantic Segmentation of Aerial Imagery",
    "seed": 42,
    "description": "Academic deep learning benchmark for semantic segmentation of high-resolution aerial imagery"
  },
  "dataset": {
    "name": "landcover.ai",
    "kaggle_slug": "adrianboguszewski/landcoverai",
    "raw_dir": "data/raw",
    "processed_dir": "data",
    "train_dir": "data/train",
    "val_dir": "data/val",
    "test_dir": "data/test",
    "tile_size": 512,
    "stride": 512,
    "image_channels": 3,
    "edge_handling": "discard",
    "split_strategy": "source_image",
    "train_ratio": 0.70,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "num_classes": 5,
    "classes": {
      "0": "Background",
      "1": "Building",
      "2": "Woodland",
      "3": "Water",
      "4": "Road"
    },
    "class_colors": {
      "0": [0, 0, 0],
      "1": [255, 0, 0],
      "2": [0, 255, 0],
      "3": [0, 0, 255],
      "4": [255, 255, 0]
    }
  },
  "dataloaders": {
    "batch_size": 8,
    "val_batch_size": 8,
    "test_batch_size": 8,
    "num_workers": 2,
    "pin_memory": true,
    "drop_last": false
  },
  "augmentations": {
    "train": {
      "horizontal_flip_prob": 0.5,
      "vertical_flip_prob": 0.5,
      "random_rotate90_prob": 0.5,
      "brightness_limit": 0.2,
      "contrast_limit": 0.2,
      "brightness_contrast_prob": 0.5
    },
    "normalization": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225],
      "max_pixel_value": 255.0
    }
  },
  "training": {
    "epochs": 40,
    "optimizer": "AdamW",
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "scheduler": "CosineAnnealingLR",
    "t_max": 40,
    "early_stopping_patience": 10,
    "mixed_precision": true,
    "gradient_clip_val": 1.0,
    "loss": {
      "name": "Combined_CE_Dice",
      "ce_weight": 0.5,
      "dice_weight": 0.5
    }
  },
  "models": {
    "encoder": "resnet34",
    "encoder_weights": "imagenet",
    "in_channels": 3,
    "classes": 5,
    "architectures": [
      "unet",
      "deeplabv3plus"
    ]
  },
  "paths": {
    "results_dir": "results",
    "checkpoints_dir": "checkpoints",
    "drive_mount_point": "/content/drive",
    "drive_project_dir": "/content/drive/MyDrive/landcover-segmentation"
  }
}
